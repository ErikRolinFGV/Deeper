# ========================================
# FSB Executive Intelligence — variáveis de ambiente
# Copie este arquivo para .env e preencha com chaves reais.
# NUNCA commitar .env no Git.
# ========================================

# ----- Banco de dados -----
# Postgres local. Crie o banco com:  createdb fsb_executive_intelligence
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/fsb_executive_intelligence

# ----- Cache e fila -----
REDIS_URL=redis://localhost:6379/0

# ----- Anthropic (Claude Sonnet) -----
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ----- Apify (LinkedIn scraping) -----
# https://console.apify.com/account/integrations
APIFY_TOKEN=apify_api_...

# ----- SerpAPI (Google search programático) -----
# https://serpapi.com/manage-api-key
SERPAPI_KEY=...

# ----- Crunchbase (carreira corporativa) -----
# https://data.crunchbase.com/docs
CRUNCHBASE_API_KEY=...

# ----- Auth interna -----
# Gere com:  python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=troque-este-valor-em-producao
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ----- App -----
APP_ENV=development
LOG_LEVEL=INFO
CACHE_TTL_DAYS=7

# Cache local das fotos de perfil (a URL do LinkedIn expira)
DIR_MEDIA=media
API_BASE_URL=http://localhost:8000
